# Copiar a .env y llenar. El .env NUNCA se sube al repositorio ni se manda por
# chat o zip: los valores reales se comparten por el canal privado del equipo.
#
# Claves: generar cada una con
#   python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Deben ser las MISMAS para todo el equipo (la base compartida está cifrada con ellas).

# ---------------------------------------------------------------- base de datos
# Neon (compartida) o el PostgreSQL del compose:
#   postgresql+psycopg2://hsr:<POSTGRES_PASSWORD>@postgres:5432/hsanrafael
DATABASE_URL=
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- seguridad
JWT_SECRET_KEY=
APP_ENCRYPTION_KEY=
APP_BLIND_INDEX_KEY=
ENTORNO=desarrollo
DEBUG=false
# Orígenes que pueden llamar a la API desde otro dominio, separados por coma.
# Detrás de nginx el front y la API comparten origen: basta el de Vite.
CORS_ORIGENES=http://localhost:5173
# true: la cuenta bloqueada solo la libera el admin (R02).
BLOQUEO_REQUIERE_ADMIN=true

# ---------------------------------------------------------------- servicios
FHIR_DB_PASSWORD=
ORTHANC_PASSWORD=
MONGO_PASSWORD=
# Secreto que HAPI manda en la cabecera del rest-hook de la Subscription (R21).
HOOK_SECRET=
# Fuera de Docker (uvicorn en tu equipo). Dentro del compose se sobrescriben.
FHIR_BASE_URL=http://localhost:8080/fhir
ORTHANC_URL=http://localhost:8042
MONGO_URL=mongodb://localhost:27017/hsr
ML_URL=http://localhost:8001

# ---------------------------------------------------------------- jornada del tablero
# Al levantar el sistema se simula la jornada en curso (cirugías, camas ocupadas).
# false = no correrlo. Con un número, se refresca cada esos minutos.
SIMULAR_JORNADA=true
JORNADA_CADA_MIN=

# ---------------------------------------------------------------- túnel (opcional)
# Vacío = quick tunnel (URL aleatoria). Para una URL fija, ver docs/DESPLIEGUE.md:
#   CLOUDFLARED_COMANDO=tunnel --no-autoupdate run --token <token de Cloudflare>
CLOUDFLARED_COMANDO=
# Minutos sin reconocer antes de escalar una alerta crítica. Lo usan el backend
# (ESCALAMIENTO_MINUTOS, en el compose) y la cuenta regresiva del front.
VITE_MINUTOS_ESCALAMIENTO=5

# ---------------------------------------------------------------- front (opcional)
# Si se define, las cuentas de demostración del login rellenan la contraseña.
# Queda visible en el JS publicado: solo con datos sintéticos.
VITE_DEMO_PASSWORD=
# false = el front no rellena con datos de ejemplo las rutas que aún no existen
# y oculta el panel de demostración (usar en la sustentación con todo desplegado).
VITE_DATOS_DEMO=true

# ---------------------------------------------------------------- reglas (opcional)
# Días que el especialista conserva acceso a la ficha tras atender una remisión.
REMISION_ACCESO_DIAS=7
# Escenario de ocupación: fracción de altas en proceso que se completan en 12 h.
FRACCION_ALTAS_12H=0.7
