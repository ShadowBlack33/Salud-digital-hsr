# API FastAPI del Hospital San Rafael.
# El contexto de construcción es la carpeta raíz del proyecto (donde está app/).
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /srv

# Primero solo las dependencias: mientras requirements.txt no cambie,
# Docker reutiliza esta capa y las reconstrucciones son rápidas.
COPY requirements.txt .
RUN pip install -r requirements.txt

# El código. El .env NO se copia a la imagen (ver .dockerignore): las claves
# entran como variables de entorno desde docker-compose (env_file).
COPY app ./app
COPY scripts ./scripts

RUN useradd --create-home --uid 10001 api
USER api

EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8000/salud', timeout=4).status == 200 else 1)"

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
